{
  "name": "backend",
  "version": "0.1.0-alpha",
  "description": "SamadhanAI Production Backend REST Gateway Service",
  "engines": {
    "node": ">=22 <23"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "echo \"No unit tests written yet\" && exit 0",
    "clean": "rimraf dist"
  },
  "keywords": [
    "samadhanai",
    "backend",
    "express",
    "typescript",
    "gateway"
  ],
  "author": "SamadhanAI Core Team",
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "@netlify/functions": "^6.0.2",
    "@types/ioredis": "^4.28.10",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "13.10.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "serverless-http": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
