# Local environment template. Copy to repository-root .env; never commit .env.
# Client configuration: public URLs only. Add up to two additional independent replicas.
API_BASE_URLS=https://api.example.com/api/v1

# Local backend
PORT=5000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8085,http://127.0.0.1:8085,http://localhost:3000,http://localhost:5000

# Private Firebase Admin credentials. In Netlify, configure these on the BACKEND site
# with Functions scope. Never put service credentials in a client build or website bundle.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Private evidence image storage. Keep all three values on the backend only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Private backend credentials
HMAC_SECRET=
JWT_SECRET=
REDIS_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=minimal
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=runixgov

# Optional communications providers
SMS_PROVIDER_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMPLOYEE_INVITATION_PAGE_URL=

# Local Android release signing only. Keep these out of source control.
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
